{
  "schemaVersion": 1,
  "id": "usefultoolsmod",
  "version": "${version}",
  "name": "The Useful Tools Mod",
  "description": "A simple mod adding various tools and armor based on reinforced versions of common materials.",
  "authors": ["stonytark_mkii"],
  "license": "CC0-1.0",
  "icon": "assets/usefultoolsmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.stonytark.usefultoolsmod.fabric.UsefultoolsModFabric"],
    "client": ["com.stonytark.usefultoolsmod.fabric.UsefultoolsModFabricClient"],
    "fabric-datagen": ["com.stonytark.usefultoolsmod.fabric.datagen.UsefulToolsFabricDataGen"],
    "fabric-gametest": ["com.stonytark.usefultoolsmod.fabric.gametest.UsefulToolsGameTests"],
    "jei_mod_plugin": ["com.stonytark.usefultoolsmod.compat.jei.UsefulToolsJeiPlugin"],
    "modmenu": ["com.stonytark.usefultoolsmod.fabric.compat.UsefulToolsModMenuPlugin"]
  },
  "mixins": [
    "usefultoolsmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "architectury": ">=13.0.0",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "jei": ">=19.0.0",
    "wthit": ">=12.0.0",
    "modmenu": ">=11.0.0",
    "magnetization": "*"
  },
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/the-useful-tools-mod",
    "sources": "https://github.com/StonyTark1117/UsefulToolsMod",
    "issues": "https://github.com/StonyTark1117/UsefulToolsMod/issues"
  }
}
